# ============================================================
# Configuration de l'Agent WhatsApp AI
# Copiez ce fichier en .env et remplissez vos valeurs
# ============================================================

# Clé API Anthropic (REQUIS)
# Obtenez votre clé sur: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modèle Claude (optionnel, défaut: claude-opus-4-6)
# Options: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5
CLAUDE_MODEL=claude-opus-4-6

# Nombre max de tokens par réponse (optionnel, défaut: 1024)
MAX_TOKENS=1024

# Nombre max de messages dans l'historique par conversation (optionnel, défaut: 20)
MAX_HISTORY=20

# Délai minimum entre messages du même contact en millisecondes (optionnel, défaut: 2000)
RATE_LIMIT_MS=2000

# Autoriser les messages de groupe WhatsApp (optionnel, défaut: false)
ALLOW_GROUPS=false

# Prompt système personnalisé (optionnel)
# SYSTEM_PROMPT=Tu es un assistant IA sympathique qui répond aux messages WhatsApp...
